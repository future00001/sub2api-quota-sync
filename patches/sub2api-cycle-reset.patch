+package service
+
+import (
+	"context"
+	"time"
+
+	infraerrors "github.com/Wei-Shaw/sub2api/internal/pkg/errors"
+	"github.com/Wei-Shaw/sub2api/internal/pkg/timezone"
+)
+
+// AdminResetQuotaForCycle atomically clears quota and anchors periodic windows to
+// the upstream seven-day cycle. The row lock makes retries safe after a lost reply.
+func (s *SubscriptionService) AdminResetQuotaForCycle(ctx context.Context, id int64, daily, weekly, monthly bool, nextReset time.Time) (*UserSubscription, error) {
+	now := s.now()
+	if (!weekly && !monthly) || !nextReset.After(now) || nextReset.After(now.Add(7*24*time.Hour+5*time.Minute)) {
+		return nil, infraerrors.BadRequest("INVALID_CYCLE_RESET_AT", "cycle_reset_at must be a future seven-day boundary and select a periodic window")
+	}
+	anchor := nextReset.Add(-7 * 24 * time.Hour)
+	var result *UserSubscription
+	err := s.withSubscriptionUpdateTx(ctx, func(txCtx context.Context) error {
+		sub, err := s.userSubRepo.GetByIDForUpdate(txCtx, id)
+		if err != nil {
+			return err
+		}
+		if sub.Status != SubscriptionStatusActive || !sub.ExpiresAt.After(now) {
+			return ErrSubscriptionExpired
+		}
+		alreadyApplied := (!weekly || (sub.WeeklyWindowStart != nil && (sub.WeeklyWindowStart.Equal(anchor) || !sub.WeeklyWindowStart.Before(nextReset)))) &&
+			(!monthly || (sub.MonthlyWindowStart != nil && (sub.MonthlyWindowStart.Equal(anchor) || !sub.MonthlyWindowStart.Before(nextReset))))
+		if !alreadyApplied {
+			if err := s.userSubRepo.ResetUsageWindows(txCtx, id, daily, weekly, monthly, timezone.StartOfDay(now), anchor); err != nil {
+				return err
+			}
+		}
+		result, err = s.userSubRepo.GetByID(txCtx, id)
+		return err
+	})
+	if err != nil {
+		return nil, err
+	}
+	if err := s.invalidateSubscriptionCaches(result.UserID, result.GroupID); err != nil {
+		return nil, err
+	}
+	return result, nil
+}
