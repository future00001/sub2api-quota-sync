+type Plugin = {plugin_key: string; state: string; compatibility?: {compatible?: boolean}; last_error?: string};
+export function isQuotaSyncPlugin(plugin: Plugin): boolean;
+export function quotaSyncStatus(plugin: Plugin, config: Record<string, unknown> | null | undefined, locale?: string): {label: string; state: 'enabled' | 'disabled' | 'starting'; mode: string; detail: string} | null;
