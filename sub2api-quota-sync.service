[Unit]
Description=Sub2API 账号 7d 周期与订阅配额同步
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/sub2api-quota-sync.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=SUB2API_ADMIN_API_KEY_FILE=%d/admin-api-key
LoadCredential=admin-api-key:/etc/sub2api-quota-sync.key
ExecStart=/usr/bin/flock -n /run/sub2api-quota-sync/lock /usr/bin/python3 /opt/sub2api-quota-sync/quota_sync.py
User=sub2api-quota-sync
Group=sub2api-quota-sync
RuntimeDirectory=sub2api-quota-sync
RuntimeDirectoryMode=0700
StateDirectory=sub2api-quota-sync
StateDirectoryMode=0700
TimeoutStartSec=3min
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectProc=invisible
ProcSubset=pid
ProtectSystem=strict
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/run/sub2api-quota-sync /var/lib/sub2api-quota-sync -/opt/sub2api/deploy/data/plugins/installed/com.hzyhz.sub2api-quota-sync

[Install]
WantedBy=multi-user.target
