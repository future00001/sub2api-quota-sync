# 未确认目标分组前保持关闭。
ENABLED=false
DRY_RUN=true

# Sub2API Admin API。systemd 从 /etc/sub2api-quota-sync.key 安全注入密钥。
SUB2API_BASE_URL=http://127.0.0.1:18080
REQUEST_TIMEOUT_SECONDS=15
STATE_PATH=/var/lib/sub2api-quota-sync/state.sqlite3

ACCOUNT_IDS=1
GROUP_IDS=

# 账号 7d 重置默认只同步订阅 weekly 窗口。
RESET_DAILY=false
RESET_WEEKLY=true
RESET_MONTHLY=false

# 只有 reset_at 至少前移 3 天，且剩余时间重新达到 5 天，才认定为新周期。
MIN_CYCLE_SHIFT_SECONDS=86400
REARM_REMAINING_SECONDS=432000
JITTER_TOLERANCE_SECONDS=21600

# 原生控制面插件保存的配置；存在时优先于以上业务设置。
PLUGIN_CONFIG_GLOB=/opt/sub2api/deploy/data/plugins/installed/com.hzyhz.sub2api-quota-sync/*/runtimes/linux-amd64/quota-sync-config.json
